# Frontend build-time settings (Vite). Never put API keys or other secrets here: they ship to the browser.
#
# No backend exists yet, so the app runs in preview mode and makes no API requests.
# Set this to 1 once the AggregateX backend is running and proxied in vite.config.js.
# VITE_BACKEND_ENABLED=1
#
# API base path used by src/api/client.js (default /api).
# VITE_API_BASE=/api
